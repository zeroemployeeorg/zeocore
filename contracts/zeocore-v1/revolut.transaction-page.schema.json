{
  "$defs": {
    "CardReference": {
      "description": "Card identity only: holder name, phone and card number are dropped.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        }
      },
      "title": "CardReference",
      "type": "object"
    },
    "Counterparty": {
      "properties": {
        "account_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Id"
        },
        "account_type": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Type"
        },
        "id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        }
      },
      "title": "Counterparty",
      "type": "object"
    },
    "Merchant": {
      "properties": {
        "category_code": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category Code"
        },
        "city": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "country": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "full_name": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Full Name"
        },
        "id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "title": "Merchant",
      "type": "object"
    },
    "Transaction": {
      "properties": {
        "card": {
          "anyOf": [
            {
              "$ref": "#/$defs/CardReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "legs": {
          "items": {
            "$ref": "#/$defs/TransactionLeg"
          },
          "title": "Legs",
          "type": "array"
        },
        "merchant": {
          "anyOf": [
            {
              "$ref": "#/$defs/Merchant"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_code": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "reference": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "related_transaction_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Related Transaction Id"
        },
        "request_id": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "scheduled_for": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled For"
        },
        "state": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "State",
          "type": "string"
        },
        "type": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Type",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "state",
        "created_at",
        "updated_at",
        "legs"
      ],
      "title": "Transaction",
      "type": "object"
    },
    "TransactionLeg": {
      "properties": {
        "account_id": {
          "format": "uuid",
          "title": "Account Id",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "balance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Balance"
        },
        "bill_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bill Amount"
        },
        "bill_currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bill Currency"
        },
        "counterparty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counterparty"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "fee": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fee"
        },
        "leg_id": {
          "format": "uuid",
          "title": "Leg Id",
          "type": "string"
        }
      },
      "required": [
        "leg_id",
        "account_id",
        "amount",
        "currency"
      ],
      "title": "TransactionLeg",
      "type": "object"
    }
  },
  "$id": "https://zeocore.zeo.ac/contracts/zeocore-v1/revolut.transaction-page.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One observation of provider state, not a stable snapshot.\n\nPages may overlap at ``next_to`` and a transaction may change between\nobservations. Key by ``id``; the projection with the later ``updated_at``\nreplaces the earlier one, and ``observed_at`` dates each observation.",
  "properties": {
    "next_to": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next To"
    },
    "normalization_version": {
      "const": "revolut-business-read-1",
      "default": "revolut-business-read-1",
      "title": "Normalization Version",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "transactions": {
      "items": {
        "$ref": "#/$defs/Transaction"
      },
      "title": "Transactions",
      "type": "array"
    }
  },
  "required": [
    "transactions",
    "observed_at"
  ],
  "title": "TransactionPage",
  "type": "object"
}
