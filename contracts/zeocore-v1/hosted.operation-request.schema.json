{
  "$defs": {
    "HostedExpectedBinding": {
      "additionalProperties": false,
      "description": "The enrolment a fenced invocation expects (contract 1.2.0 §6a).\n\nThe Broker compares both values with the connection as it is enrolled,\nbefore custody and again before each provider call, and refuses a\nmismatch. Take them from a fresh ``list_connections`` through\n``HostedConnectionSummary.expected_binding()``.",
      "properties": {
        "connection_revision": {
          "pattern": "^[1-9][0-9]{0,18}$",
          "title": "Connection Revision",
          "type": "string"
        },
        "external_identity": {
          "maxLength": 500,
          "minLength": 1,
          "title": "External Identity",
          "type": "string"
        }
      },
      "required": [
        "external_identity",
        "connection_revision"
      ],
      "title": "HostedExpectedBinding",
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "https://zeocore.zeo.ac/contracts/zeocore-v1/hosted.operation-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact named operation request; no tenant, URL, method, header, or token.",
  "properties": {
    "arguments": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Arguments",
      "type": "object"
    },
    "connection_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Connection Id",
      "type": "string"
    },
    "connector_revision": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Connector Revision"
    },
    "expect": {
      "anyOf": [
        {
          "$ref": "#/$defs/HostedExpectedBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "idempotency_key": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "operation_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    }
  },
  "required": [
    "connection_id",
    "operation_id",
    "arguments",
    "idempotency_key"
  ],
  "title": "HostedOperationRequest",
  "type": "object"
}
